FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y \
    git \
    curl \
    bash \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum* ./
RUN go mod download

RUN go install golang.org/x/tools/gopls@latest

# Claude Codeをインストール
RUN npm install -g @anthropic-ai/claude-code

COPY . .

EXPOSE 8080

CMD ["go", "run", "./cmd/api"]