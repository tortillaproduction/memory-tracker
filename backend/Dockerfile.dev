# Codespaces/開発用Dockerfile。
# VSCode RemoteがSSH接続できるようcurl/bash/git等のツールを含むDebianベースを使う。
# alpineはVSCode Remoteと相性が悪いためここではDebian系を採用。
FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y \
    git \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS（LTSの最新版）をNodeSource経由でインストール。
# aptのデフォルトは古いバージョンになるためこの方法を採用。
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum* ./
RUN go mod download

# goplsはVSCodeのgolang.go拡張機能が自動でインストールするため不要。
# go install golang.org/x/tools/gopls@latest は
# gopls v0.23.0 が Go 1.26+ を要求するため Go 1.24 環境では動かない。

# Claude Codeをインストール
RUN npm install -g @anthropic-ai/claude-code

COPY . .

EXPOSE 8080

CMD ["go", "run", "./cmd/api"]