# Codespaces/開発用Dockerfile。
# VSCode RemoteがSSH接続できるようcurl/bash/git等のツールを含むDebianベースを使う。
# alpineはVSCode Remoteと相性が悪いためここではDebian系を採用。
FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y \
    git \
    curl \
    bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum* ./
RUN go mod download

# gopls（Go言語サーバー）をインストール
RUN go install golang.org/x/tools/gopls@latest

COPY . .

EXPOSE 8080

CMD ["go", "run", "./cmd/api"]