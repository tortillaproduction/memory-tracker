# Backend
DATABASE_URL=postgres://postgres:postgres@db:5432/memorytracker?sslmode=disable

# マイグレーション自動実行(開発時はtrue推奨)
# 本番相当の検証時は docker-compose.prod.yml を重ねて使うとfalseになり、
# 専用のmigrateコンテナが事前に1回だけ実行する運用に切り替わる。
AUTO_MIGRATE=true

# Frontend (Oauthコールバック後のリダイレクト先、CORS許可オリジンにも使用)
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Session
SESSION_SECRET=change_me_in_production

# Email通知 (SMTP) — SMTP_HOSTを設定するとResendより優先される
# Gmailの場合: 2段階認証を有効にし、https://myaccount.google.com/apppasswords で発行したアプリパスワードを使う
# EMAIL_FROM_ADDRESS未設定時はSMTP_USERNAMEが送信元になる
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Email通知 (Resend)
# 未設定の場合は通知バッチが無効化される（APIサーバーは通常通り動作）
# 開発・動作確認時はEMAIL_FROM_ADDRESSをonboarding@resend.devのままにするとドメイン認証不要で送信可能
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Memory Tracker

# ブラウザ通知 (Web Push)
# 未設定の場合はプッシュ送信が無効化される（購読/設定APIやメール通知バッチは通常通り動作）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# 通知バッチの実行間隔（省略時は5m）。開発中に通知を素早く確認したいときだけ1mなどに短縮する
# NOTIFICATION_INTERVAL=1m

# LINE通知（未実装。実装後に有効化）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Stripe（Phase 2、有料プラン導入時）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
