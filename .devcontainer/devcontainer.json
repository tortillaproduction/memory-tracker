{
  "name": "Memory Tracker",

  // docker-compose.ymlとCodespaces用オーバーライドを使って全コンテナを起動する。
  // Codespaces起動時に frontend / app / db が全て自動で立ち上がる。
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.codespaces.yml"
  ],

  // VSCodeが接続するメインコンテナ。
  // Dockerfile.devで起動するGoの開発環境コンテナ。
  "service": "app",
  "workspaceFolder": "/workspace",

  // runServicesに全サービスを指定することで、
  // Codespaces起動時にfrontend/app/db全てが自動起動する。
  "runServices": ["frontend", "app", "db"],

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "editor.formatOnSave": true,
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "forwardPorts": [5173, 8080, 5432],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" },
    "8080": { "label": "Backend (Go API)" },
    "5432": { "label": "PostgreSQL" }
  },

  // 起動後に.envを自動コピー
  "postCreateCommand": "cp -n .env.example .env 2>/dev/null || true"
}