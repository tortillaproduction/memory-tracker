{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://memory-tracker-rlsq.onrender.com/api/$1"
    },
    {
      "source": "/go/(.*)",
      "destination": "https://memory-tracker-rlsq.onrender.com/go/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
